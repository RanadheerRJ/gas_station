rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- helpers ---------------- */

    function signedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function isAdmin() {
      return signedIn() && claims().admin == true;
    }

    function isOwner() {
      return signedIn() && claims().role == 'owner';
    }

    function isManager() {
      return signedIn() && claims().role == 'manager';
    }

    // Owner or manager: the two roles allowed to rewrite history.
    function canAmend() {
      return isOwner() || isManager();
    }

    function stationDoc(stationId) {
      return get(/databases/$(database)/documents/stations/$(stationId)).data;
    }

    // An owner reaches every station carrying their ownerId claim;
    // single-station staff reach only the station in their stationId claim.
    function hasStationAccess(stationId) {
      return signedIn() && (
        (isOwner() && stationDoc(stationId).ownerId == claims().ownerId) ||
        (claims().stationId == stationId)
      );
    }

    /* ---------------- accounts & stations ----------------
       All writes go through Cloud Functions (Admin SDK bypasses rules).
       Clients get read access only, and only to what concerns them.      */

    match /users/{uid} {
      // The developer lists owners in order to reset their PINs; owners see
      // their own staff; everyone sees themselves.
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (isOwner() && resource.data.ownerId == claims().ownerId)
      );
      allow write: if false;
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /authSecrets/{uid} {
      allow read, write: if false;
    }

    match /loginAttempts/{username} {
      allow read, write: if false;
    }

    match /stations/{stationId} {
      allow read: if signedIn() && (
        (isOwner() && resource.data.ownerId == claims().ownerId) ||
        claims().stationId == stationId
      );
      // Creation and deletion both run through Cloud Functions: deleting a
      // station has to cascade through its pumps, nozzles, prices, shifts
      // and credit ledger, which a client rule cannot enforce.
      allow write: if false;
    }

    /* ---------------- pumps, nozzles & rates ----------------
       Equipment and pricing are owner-controlled. Staff read them so a
       shift can snapshot readings and rates, but never change them.
       Nozzle totalisers advance only via the closeShift function.        */

    match /stations/{stationId}/pumps/{pumpId} {
      allow read: if hasStationAccess(stationId);
      allow write: if hasStationAccess(stationId) && isOwner();
    }

    match /stations/{stationId}/nozzles/{nozzleId} {
      allow read: if hasStationAccess(stationId);
      allow create, delete: if hasStationAccess(stationId) && isOwner();
      // lastReading is advanced by closeShift via the Admin SDK.
      allow update: if hasStationAccess(stationId) && isOwner();
    }

    /* ---------------- tanks & ground stock ----------------
       Tanks are owner-configured plant. Their stock level is advanced only
       by the recordDip / recordDelivery functions, which validate the
       reading against capacity and keep the dip log in step — so a client
       can never quietly move stock without leaving a reading behind.

       Note there is no delete path anywhere in this file for tanks,
       stations, pumps or nozzles. Plant is retired via a state field and
       can always be returned to service; history is never destroyed.      */

    match /stations/{stationId}/tanks/{tankId} {
      allow read: if hasStationAccess(stationId);
      allow write: if false;
    }

    /* Dip and delivery readings: append-only history, written server-side.
       Nobody edits a dip after the fact; a wrong reading is superseded by
       taking another one, which is how a paper dip book works too.        */
    match /tankReadings/{stationId}/readings/{readingId} {
      allow read: if hasStationAccess(stationId);
      allow write: if false;
    }

    /* Effective-dated price intervals. Written only by the setPrice
       function, which closes the previous interval as it opens the next. */
    match /stations/{stationId}/prices/{priceId} {
      allow read: if hasStationAccess(stationId);
      allow write: if false;
    }

    /* ---------------- shifts ----------------
       Opening, closing, revising and reviewing all run through Cloud
       Functions so meter advancement, credit posting and the approval
       stage stay atomic and auditable.

       A shift's life: open -> pending_review -> approved (terminal), with
       rejected as a loop back to pending_review. Approval is what releases
       the cash handover figure to the owner's books, so it is never a
       client write: the reviewShift function checks the role and stamps
       who signed off. Likewise the status field itself is never editable
       from a client, which is why update is closed here rather than being
       left open to owner/manager with a field filter.                     */

    match /shifts/{stationId}/records/{shiftId} {
      allow read: if hasStationAccess(stationId);
      allow write: if false;
    }

    /* ---------------- ledger ---------------- */

    match /ledger/{stationId}/entries/{entryId} {
      allow read: if hasStationAccess(stationId);
      allow create: if hasStationAccess(stationId)
                    && request.resource.data.enteredBy == request.auth.uid;
      // Attendants log the day; only owner/manager may correct it later.
      allow update, delete: if hasStationAccess(stationId) && canAmend();
    }

    /* ---------------- credit customers ----------------
       Mirrors the ledger pattern: staff may open an account, but the money
       on it moves only through the recordCustomerPayment function, which
       increments inside a transaction. A client read-modify-write would
       lose one of two concurrent payments.

       Walk-in accounts are also opened server-side by closeShift when a
       payer has no existing record, so no debt is ever anonymous.         */

    match /creditCustomers/{stationId}/customers/{customerId} {
      allow read: if hasStationAccess(stationId);

      // A new account always starts square and empty.
      allow create: if hasStationAccess(stationId)
                    && request.resource.data.outstandingBalance == 0
                    && request.resource.data.transactions.size() == 0;

      // Contact details are correctable; the balance and its history are not.
      allow update: if hasStationAccess(stationId)
                    && request.resource.data.outstandingBalance
                       == resource.data.outstandingBalance
                    && request.resource.data.transactions
                       == resource.data.transactions;

      allow delete: if false;
    }

    /* Anything not matched above is denied. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
