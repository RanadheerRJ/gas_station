# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
# The app will not sign anyone in without these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region your Cloud Functions are deployed to. Must match, or every callable
# fails with an unhelpful "internal" error.
VITE_FUNCTIONS_REGION=us-central1

# Set to true to point the app at the local emulator suite instead of the real
# project (npm run emulators). The VITE_FIREBASE_* values above still need to
# be present, but may be dummies.
VITE_USE_EMULATORS=false
