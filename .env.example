# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# The anonymous key is expected to be public in a browser build; database RLS
# and SECURITY DEFINER RPCs enforce access. Never put service_role here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
