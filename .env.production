# Production configuration is injected by .github/workflows/deploy-pages.yml
# from GitHub Actions repository variables. Keep this file credential-free.
#
# Configure these values in Settings → Secrets and variables → Actions → Variables:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#
# The anonymous/publishable key is safe to expose in the built site. Do NOT add
# SUPABASE_SERVICE_ROLE_KEY here or to GitHub Pages; it belongs only to the
# deployed Supabase Edge Function runtime.
