# Firebase config for the deployed (GitHub Pages) build.
#
# These values are committed on purpose. Firebase web config is not a secret:
# it ships inside the JavaScript bundle and is readable by anyone who opens
# the site. Keeping it in repository secrets would hide it from you without
# hiding it from anyone else, and would mean the Pages deploy silently breaks
# for anyone who forgets to set them.
#
# What actually protects the data is firestore.rules, every write going
# through an authenticated Cloud Function, and no account being creatable
# without an existing privileged account. See the security section in
# README.md before putting real money through this.
VITE_FIREBASE_API_KEY=AIzaSyDWnmHmjAnjjkYACMZEUFoAWfHk7vlpK_o
VITE_FIREBASE_AUTH_DOMAIN=gasstation-7c7ab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gasstation-7c7ab
VITE_FIREBASE_STORAGE_BUCKET=gasstation-7c7ab.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=91745032420
VITE_FIREBASE_APP_ID=1:91745032420:web:94f6771d5927228e6cb4f1
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=false
